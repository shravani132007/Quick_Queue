@app.route("/api/shops/<int:shop_id>/menu", methods=["GET"])
def get_menu_items(shop_id):
    category = request.args.get("category")
    conn = get_db()
    cursor = conn.cursor()

    if category and category.lower() != "all":
        cursor.execute(
            "SELECT * FROM menu_items WHERE shop_id = ? AND category = ? ORDER BY id ASC",
            (shop_id, category),
        )
    else:
        cursor.execute(
            "SELECT * FROM menu_items WHERE shop_id = ? ORDER BY id ASC",
            (shop_id,),
        )

    rows = cursor.fetchall()
    conn.close()

    dishes = [
        {
            "id": row["id"],
            "shop_id": row["shop_id"],
            "name": row["name"],
            "category": row["category"],
            "price": float(row["price"]),
            "quantity": row["quantity"],
            "is_available": bool(row["is_available"]),
            "day_of_week": row["day_of_week"],
            "image_url": row["image_url"]
        }
        for row in rows
    ]
    return jsonify({"success": True, "dishes": dishes}), 200


@app.route("/api/shops/<int:shop_id>/menu", methods=["POST"])
def add_menu_item(shop_id):
    data = request.get_json() or {}
    name = data.get("name", "").strip()
    category = data.get("category", "Snacks").strip()
    price = data.get("price")
    quantity = data.get("quantity", 50)
    day_of_week = data.get("day_of_week", "All")

    if not name or price is None or float(price) <= 0:
        return jsonify({"error": "Valid name and positive price are required"}), 400

    conn = get_db()
    cursor = conn.cursor()
    cursor.execute(
        """
        INSERT INTO menu_items (shop_id, name, category, price, quantity, is_available, day_of_week)
        VALUES (?, ?, ?, ?, ?, 1, ?)
        """,
        (shop_id, name, category, float(price), int(quantity), day_of_week),
    )
    conn.commit()
    item_id = cursor.lastrowid
    conn.close()

    return jsonify({
        "success": True,
        "message": "Dish added to menu",
        "dish_id": item_id
    }), 201


@app.route("/api/menu/<int:item_id>", methods=["PUT"])
def update_menu_item(item_id):
    data = request.get_json() or {}
    conn = get_db()
    cursor = conn.cursor()

    cursor.execute(
        """
        UPDATE menu_items
        SET name = COALESCE(?, name),
            category = COALESCE(?, category),
            price = COALESCE(?, price),
            quantity = COALESCE(?, quantity),
            is_available = COALESCE(?, is_available)
        WHERE id = ?
        """,
        (
            data.get("name"),
            data.get("category"),
            data.get("price"),
            data.get("quantity"),
            data.get("is_available"),
            item_id,
        ),
    )
    conn.commit()
    affected = cursor.rowcount
    conn.close()

    if affected == 0:
        return jsonify({"error": "Menu item not found"}), 404

    return jsonify({"success": True, "message": "Dish updated successfully"}), 200


@app.route("/api/menu/<int:item_id>", methods=["DELETE"])
def delete_menu_item(item_id):
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("DELETE FROM menu_items WHERE id = ?", (item_id,))
    conn.commit()
    affected = cursor.rowcount
    conn.close()

    if affected == 0:
        return jsonify({"error": "Menu item not found"}), 404

    return jsonify({"success": True, "message": "Dish deleted successfully"}), 200



@app.route("/api/auth/login", methods=["POST"])
def login():
    data = request.get_json() or {}
    username = data.get("username", "").strip()
    password = data.get("password", "").strip()
    role = (data.get("role") or "user").strip().lower()

    if not username or not password:
        return jsonify({"error": "Username/email and password are required"}), 400

    conn = get_db()
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT id, username, email, role, phone
        FROM users
        WHERE (LOWER(username) = LOWER(?) OR LOWER(email) = LOWER(?))
          AND password_hash = ?
          AND LOWER(role) = LOWER(?)
        """,
        (username, username, password, role),
    )
    user = cursor.fetchone()

    shop_info = None
    if user and role == "admin":
        cursor.execute(
            """
            SELECT id, shop_no, name, owner_name, contact_no, location_type, location, is_open, image_url
            FROM shops
            WHERE admin_id = ?
               OR (contact_no = ? AND contact_no != '')
               OR (LOWER(owner_name) = LOWER(?) AND owner_name != '')
            ORDER BY id ASC LIMIT 1
            """,
            (user["id"], user["phone"], user["username"]),
        )
        s_row = cursor.fetchone()
        if s_row:
            shop_info = {
                "id": s_row["id"],
                "shop_no": s_row["shop_no"],
                "name": s_row["name"],
                "owner_name": s_row["owner_name"],
                "contact_no": s_row["contact_no"],
                "location_type": s_row["location_type"],
                "location": s_row["location"],
                "is_open": bool(s_row["is_open"]),
                "image_url": s_row["image_url"],
            }
    conn.close()

    if user:
        return jsonify({
            "success": True,
            "message": f"Logged in as {role.upper()}",
            "user": {
                "id": user["id"],
                "username": user["username"],
                "email": user["email"],
                "role": user["role"],
                "phone": user["phone"]
            },
            "shop": shop_info
        }), 200
    else:
        # For testing / prototype simplicity: fallback match or invalid credentials
        return jsonify({
            "success": False,
            "error": "Invalid credentials or role mismatch"
        }), 401


@app.route("/api/auth/register", methods=["POST"])
def register():
    data = request.get_json() or {}
    username = data.get("username", "").strip()
    email = data.get("email", "").strip()
    password = data.get("password", "").strip()
    role = data.get("role", "user")
    phone = data.get("phone", "")

    if not username or not email or not password:
        return jsonify({"error": "Username, email, and password are required"}), 400

    conn = get_db()
    cursor = conn.cursor()
    try:
        cursor.execute(
            "INSERT INTO users (username, email, password_hash, role, phone) VALUES (?, ?, ?, ?, ?)",
            (username, email, password, role, phone),
        )
        conn.commit()
        user_id = cursor.lastrowid
        conn.close()
        return jsonify({
            "success": True,
            "message": "User registered successfully",
            "user_id": user_id
        }), 201
    except sqlite3.IntegrityError:
        conn.close()
        return jsonify({"error": "Username or email already exists"}), 409



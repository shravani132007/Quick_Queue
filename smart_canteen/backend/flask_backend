@app.route("/api/orders", methods=["POST"])
def place_order():
    data = request.get_json() or {}
    shop_id = data.get("shop_id", 1)
    customer_name = data.get("customer_name", "Student").strip()
    items = data.get("items", [])  # list of {menu_item_id, quantity, name, price}

    if not items:
        return jsonify({"error": "Order must contain at least one item"}), 400

    # Generate token e.g. #TK-4829
    token = f"#TK-{random.randint(1000, 9999)}"

    conn = get_db()
    cursor = conn.cursor()

    total_amount = 0.0
    order_items_to_insert = []

    for item in items:
        dish_id = item.get("menu_item_id")
        qty = int(item.get("quantity", 1))

        cursor.execute("SELECT id, name, price, quantity FROM menu_items WHERE id = ?", (dish_id,))
        dish = cursor.fetchone()
        if not dish:
            continue

        item_name = dish["name"]
        price = float(dish["price"])
        subtotal = price * qty
        total_amount += subtotal

        # Decrease inventory if available
        new_qty = max(0, dish["quantity"] - qty)
        cursor.execute("UPDATE menu_items SET quantity = ? WHERE id = ?", (new_qty, dish_id))

        order_items_to_insert.append((dish_id, item_name, qty, price, subtotal))

    cursor.execute(
        """
        INSERT INTO orders (token, shop_id, customer_name, total_amount, status, payment_status, payment_method)
        VALUES (?, ?, ?, ?, 'pending', 'paid', 'UPI')
        """,
        (token, shop_id, customer_name, total_amount),
    )
    order_id = cursor.lastrowid

    for o_item in order_items_to_insert:
        cursor.execute(
            """
            INSERT INTO order_items (order_id, menu_item_id, item_name, quantity, unit_price, subtotal)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (order_id, o_item[0], o_item[1], o_item[2], o_item[3], o_item[4]),
        )

    conn.commit()
    conn.close()

    return jsonify({
        "success": True,
        "message": "Order placed successfully!",
        "token": token,
        "order_id": order_id,
        "total_amount": total_amount,
        "status": "pending"
    }), 201


@app.route("/api/shops/<int:shop_id>/orders", methods=["GET"])
def get_incoming_orders(shop_id):
    conn = get_db()
    cursor = conn.cursor()

    cursor.execute(
        "SELECT * FROM orders WHERE shop_id = ? ORDER BY id DESC",
        (shop_id,),
    )
    order_rows = cursor.fetchall()

    orders_list = []
    for o in order_rows:
        cursor.execute(
            "SELECT item_name, quantity, unit_price, subtotal FROM order_items WHERE order_id = ?",
            (o["id"],),
        )
        item_rows = cursor.fetchall()
        items = [
            {
                "name": ir["item_name"],
                "qty": ir["quantity"],
                "price": float(ir["unit_price"]),
                "subtotal": float(ir["subtotal"])
            }
            for ir in item_rows
        ]

        orders_list.append({
            "id": o["id"],
            "token": o["token"],
            "customer_name": o["customer_name"],
            "total": float(o["total_amount"]),
            "status": o["status"],
            "payment_status": o["payment_status"],
            "created_at": o["created_at"],
            "items": items
        })

    conn.close()
    return jsonify({"success": True, "orders": orders_list}), 200


@app.route("/api/orders/<int:order_id>/status", methods=["PATCH"])
def update_order_status(order_id):
    data = request.get_json() or {}
    new_status = data.get("status", "").lower()

    valid_statuses = ["pending", "preparing", "ready", "completed", "rejected"]
    if new_status not in valid_statuses:
        return jsonify({"error": f"Invalid status. Must be one of {valid_statuses}"}), 400

    conn = get_db()
    cursor = conn.cursor()
    cursor.execute(
        "UPDATE orders SET status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
        (new_status, order_id),
    )
    conn.commit()
    affected = cursor.rowcount
    conn.close()

    if affected == 0:
        return jsonify({"error": "Order not found"}), 404

    return jsonify({
        "success": True,
        "message": f"Order status updated to '{new_status}'"
    }), 200



@app.route("/api/shops", methods=["GET"])
def get_shops():
    admin_id = request.args.get("admin_id")
    owner_phone = request.args.get("phone")
    owner_name = request.args.get("owner")

    conn = get_db()
    cursor = conn.cursor()

    if admin_id or owner_phone or owner_name:
        cursor.execute(
            """
            SELECT * FROM shops
            WHERE (admin_id = ? AND admin_id IS NOT NULL)
               OR (contact_no = ? AND contact_no != '')
               OR (LOWER(owner_name) = LOWER(?) AND owner_name != '')
            ORDER BY id ASC
            """,
            (admin_id, owner_phone or "", owner_name or ""),
        )
    else:
        cursor.execute("SELECT * FROM shops ORDER BY id ASC")

    rows = cursor.fetchall()
    conn.close()

    shops = [
        {
            "id": row["id"],
            "shop_no": row["shop_no"],
            "name": row["name"],
            "owner_name": row["owner_name"],
            "contact_no": row["contact_no"],
            "location_type": row["location_type"],
            "location": row["location"],
            "is_open": bool(row["is_open"]),
            "image_url": row["image_url"],
            "admin_id": row["admin_id"] if "admin_id" in row.keys() else None,
        }
        for row in rows
    ]
    return jsonify({"success": True, "shops": shops}), 200


@app.route("/api/shops", methods=["POST"])
def register_shop():
    data = request.get_json() or {}
    shop_no = data.get("shop_no", "").strip()
    name = data.get("name", "").strip()
    owner_name = data.get("owner_name", "").strip()
    contact_no = data.get("contact_no", "").strip()
    location_type = data.get("location_type", "Main Canteen").strip()
    location = data.get("location", "").strip()
    image_url = data.get("image_url", "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=800&auto=format&fit=crop")
    admin_id = data.get("admin_id")

    if not shop_no or not name or not contact_no or not location:
        return jsonify({"error": "Shop number, name, contact number, and location are required"}), 400

    conn = get_db()
    cursor = conn.cursor()

    if not admin_id:
        cursor.execute(
            "SELECT id FROM users WHERE (phone = ? OR LOWER(username) = LOWER(?)) AND role = 'admin' LIMIT 1",
            (contact_no, owner_name),
        )
        matched_user = cursor.fetchone()
        if matched_user:
            admin_id = matched_user["id"]

    try:
        cursor.execute(
            """
            INSERT INTO shops (shop_no, name, owner_name, contact_no, location_type, location, is_open, image_url, admin_id)
            VALUES (?, ?, ?, ?, ?, ?, 1, ?, ?)
            """,
            (shop_no, name, owner_name, contact_no, location_type, location, image_url, admin_id),
        )
        conn.commit()
        shop_id = cursor.lastrowid
        conn.close()
        return jsonify({
            "success": True,
            "message": "Shop registered successfully",
            "shop_id": shop_id
        }), 201
    except sqlite3.IntegrityError:
        conn.close()
        return jsonify({"error": f"Shop with number {shop_no} already exists"}), 409


@app.route("/api/shops/<int:shop_id>", methods=["GET"])
def get_shop_by_id(shop_id):
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM shops WHERE id = ?", (shop_id,))
    row = cursor.fetchone()
    conn.close()

    if not row:
        return jsonify({"error": "Shop not found"}), 404

    return jsonify({
        "success": True,
        "shop": dict(row)
    }), 200


